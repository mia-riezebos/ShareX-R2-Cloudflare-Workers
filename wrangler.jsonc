{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sharex-r2-upload",
	"main": "./src/index.ts",
	"account_id": "492214885e7a580ccc1d141dfdb4dc5f",
	"compatibility_date": "2026-08-11",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"routes": [
		{
			"pattern": "i.mia.cx",
			"custom_domain": true
		}
	],
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "i-mia-cx"
		}
	],
	"observability": {
		"enabled": true
	}
}
